# AI Sales Inbox — Phase 1 environment (copy to apps/api/.env and workers/queue/.env as needed)
# NEVER commit a real .env with secrets. Generate secrets with: openssl rand -hex 32
PORT=4000
DATABASE_URL=postgres://ai_inbox:ai_inbox_dev@localhost:5432/ai_inbox
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# 32-byte hex (64 hex chars) for AES-256-GCM channel-token encryption
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# AI provider: 'gemini' (needs billing on the Google Cloud project; also note
# gemini-2.5-flash is no longer available to new users — the API suggests
# gemini-3.8-flash) or 'groq' (FREE: no credit card, key active on signup
# at console.groq.com, 30 requests/min, 1,000 requests/day). Groq replies
# cost 0 paisa and are logged in ai_usage_ledger with provider='groq'.
AI_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
FREE_CREDIT_PAISA=5000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=ai-inbox
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-verify-token
WEBCHAT_SECRET=change-me-webchat-secret
# Demo seed only: set SEED_DEMO=true to allow `npm run seed`
SEED_DEMO=false

# Phase 2/3 approval gates — false (বা খালি) মানে এখনো অনুমোদন হয়নি।
# WhatsApp Cloud API অনুমোদন না পাওয়া পর্যন্ত WhatsApp চ্যানেল
# pending_approval থাকবে; TikTok-ও তাই। TikTok পোস্ট সিডিউলিংয়ের জন্য
# TikTok Content Posting API অডিট পাস করতে হয় (TIKTOK_SCHEDULING_AUDITED)।
WHATSAPP_APPROVED=false
TIKTOK_COMMENTS_APPROVED=false
TIKTOK_SCHEDULING_AUDITED=false
WHATSAPP_VERIFY_TOKEN=
# ছবি দিয়ে প্রোডাক্ট খোঁজার embedding সার্ভিস। খালি থাকলে stub চলবে —
# ছবি-খোঁজা "চালু নেই" বলবে, কখনো ভুয়া মিল দেখাবে না।
EMBEDDING_PROVIDER=
